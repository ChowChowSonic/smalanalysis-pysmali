# ANSI color codes for better diff visualization
class Colors:
    RED = '\033[91m'      
    GREEN = '\033[92m'    
    CYAN = '\033[96m'     
    YELLOW = '\033[93m'   
    BLUE = '\033[94m'     
    BOLD = '\033[1m'      
    RESET = '\033[0m'     

def supports_color():
    """Check if the terminal supports color output"""
    return sys.stdout.isatty()

def colorize(text, color):
    """Apply color to text if terminal supports it"""
    if supports_color():
        return f"{color}{text}{Colors.RESET}"
    return text

logging.basicConfig(level=logging.INFO, format='[%(levelname)s] %(message)s', stream=sys.stderr)

# Patterns for all invoke types in smali
INVOKE_PATTERNS = [
    re.compile(r'^\s*invoke-static(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-virtual(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-direct(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-interface(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-super(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-polymorphic(/range)?\s*\{[^}]*\},\s*(.*?)->(.*?)\((.*?)\)(.*)$'),
    re.compile(r'^\s*invoke-custom(/range)?\s*\{[^}]*\},\s*(.*?)\((.*?)\)(.*)$'),
]

def extract_invoked_functions(method):
    """Extract all functions invoked by a method"""
    if method is None:
        return set()
    
    invoked_functions = set()
    lines = method.getCleanLines()
    
    for line in lines:
        line = line.strip()
        for pattern in INVOKE_PATTERNS:
            match = pattern.match(line)
            if match:
                groups = match.groups()
                if len(groups) >= 3:
                    # For invoke-custom, the format is different
                    if 'invoke-custom' in pattern.pattern:
                        # invoke-custom has format: invoke-custom {registers}, method_name(method_params)return_type
                        method_call = groups[0]
                        params = groups[1]
                        return_type = groups[2] if len(groups) > 2 else ''
                        # Format as: method_name(params)return_type
                        full_signature = f"{method_call}({params}){return_type}"
                    else:
                        # Standard invoke format: class->method(params)return_type
                        # groups[0] is the /range part (or None), groups[1] is class, groups[2] is method, groups[3] is params, groups[4] is return type
                        range_part = groups[0]
                        class_name = groups[1].strip() if len(groups) > 1 else ''
                        method_name = groups[2].strip() if len(groups) > 2 else ''
                        params = groups[3].strip() if len(groups) > 3 else ''
                        return_type = groups[4].strip() if len(groups) > 4 else ''
                        full_signature = f"{class_name}->{method_name}({params}){return_type}"
                    
                    invoked_functions.add(full_signature)
                break
    
    return invoked_functions

def print_invoked_functions_diff(old_method, new_method):
    """Print the diff of invoked functions between old and new methods in concise format"""
    old_invoked = extract_invoked_functions(old_method)
    new_invoked = extract_invoked_functions(new_method)
    
    # Old version line
    old_list = ", ".join(sorted(old_invoked)) if old_invoked else "none"
    print(f"{old_method.getFullSignature()}: [{old_list}]")
    
    # New version line  
    new_list = ", ".join(sorted(new_invoked)) if new_invoked else "none"
    print(f"{new_method.getFullSignature()}: [{new_list}]")
    print()

parser = argparse.ArgumentParser(description='Compute evolution metrics between two smali versions.')
