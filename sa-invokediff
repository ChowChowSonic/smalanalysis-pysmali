            # Get the lines from both methods
            old_lines = old_method.getCleanLines()
            new_lines = new_method.getCleanLines()
            
            print(colorize(f"CHANGED: {old_method.getFullSignature()}", Colors.BLUE))
            
            # Add invoked functions analysis (removing textual diff)
