import argparse
import sys
import os
import pathlib
from tabnanny import verbose
import smalanalysis
import logging 
from smalanalysis.smali import SmaliObject, ChangesTypes, SmaliProject, Metrics

logging.basicConfig(level=logging.INFO, format='[%(levelname)s] %(message)s', stream=sys.stderr)

parser = argparse.ArgumentParser(description='Compute evolution metrics between two smali versions.')
parser.add_argument('smaliv1', type=str,
                    help='Version 1 folder containing smali files')
parser.add_argument('smaliv2', type=str,
                    help='Version 2 folder containing smali files')
parser.add_argument('output_dir', type=str,
                    help='Output directory for extracted functions')
parser.add_argument('--verbose', '-v', action='store_true',
                    help='Show metrics details')
parser.add_argument('--fulllinesofcode', '-f', action='store_true',
                    help='Show full lines instead of opcodes for differences')
parser.add_argument('--aggregateoperators', '-a', action='store_true',
                    help='Aggregate the operator by their first keywork.')
parser.add_argument('--include-unpackaged', '-U', action='store_true',
                    help='Includes classes which are not in a package')
parser.add_argument('--exclude-lists', '-e', type=str, nargs='*',
                    help='Files containing excluded list')
parser.add_argument('--include-lists', '-i', type=str, nargs='*',
                    help='Files containing included list')
parser.add_argument('--no-innerclasses-split', '-I', action='store_true',
                    help='Do not split metrics for inner/outer classes')
parser.add_argument('--no-pysmali', action='store_true',
                    help='Do not use the pysmali parser (use legacy parser instead)')
parser.add_argument('--filter-classes', '-F', type=str,
                    help='File containing list of classes to filter for (one class per line)')

args = parser.parse_args()

# Create output directory structure
output_dir = pathlib.Path(args.output_dir)
new_dir = output_dir / "new"
old_dir = output_dir / "old"

if args.verbose:
    print(f"Creating output directory: {output_dir}")

# Create directories
output_dir.mkdir(parents=True, exist_ok=True)
new_dir.mkdir(parents=True, exist_ok=True)
old_dir.mkdir(parents=True, exist_ok=True)

if args.verbose and args.exclude_lists:
    print("Ignoring classes includes in these files: %s" % args.exclude_lists)

# Load filter classes if specified
filter_classes = None
if args.filter_classes:
    try:
        with open(args.filter_classes, 'r') as f:
            filter_classes = set(line.strip() for line in f if line.strip() and not line.startswith('#'))
        if args.verbose:
            print(f"Loaded {len(filter_classes)} classes to filter from {args.filter_classes}")
    except Exception as e:
        print(f"Error reading filter classes file: {e}", file=sys.stderr)
        sys.exit(1)

def should_filter_class(class_name):
    """Check if a class should be included based on filter classes"""
    if filter_classes is None:
        return True  # No filtering applied
    
    # Convert class name to various formats for matching
    clean_class = class_name.rstrip(';')
    if not clean_class.startswith('L'):
        clean_class = 'L' + clean_class
    if not clean_class.endswith(';'):
        clean_class = clean_class + ';'
    
    # Check all possible formats
    formats_to_check = [
        class_name,
        clean_class,
        class_name.rstrip(';'),
        clean_class[1:-1],  # Remove L and ;
        clean_class.replace('/', '.')  # Java format
    ]
    
    return any(fmt in filter_classes or fmt.replace('/', '.') in filter_classes for fmt in formats_to_check)

if args.aggregateoperators and args.fulllinesofcode:
    print("Aggregation and full lines cannot be enabled at the same time!")
    sys.exit(1)

def get_package_path(class_name):
    """Convert class name to package directory path"""
    # Convert Lcom/example/Class; to com/example/Class
    if class_name.startswith('L'):
        class_name = class_name[1:]
    if class_name.endswith(';'): 
        class_name = class_name[:-1]
    return class_name.replace('/', os.sep).replace('.', os.sep)

def write_function_to_file(method_obj, output_base_dir, version_name):
    """Write a method's smali code to a file"""
    if method_obj is None:
        return
    
    class_name = method_obj.getFullSignature().split(':')[0].strip()
    method_name = method_obj.getFullSignature().split('(')[0].split(' ')[-1].split('.')[-1].replace('<', '__').replace('>', '__')

    # Get package path and create directory structure
    package_path = get_package_path(class_name)
    class_dir = output_base_dir / package_path
    class_dir.mkdir(parents=True, exist_ok=True)
    
    # Write the method content
    output_file = class_dir / f"{method_name}.smali"
    
    try:
        with open(output_file, 'w', encoding='utf-8') as f:
            # Write the method's smali code
            f.write(f"# Method: {method_obj.getFullSignature()}\n")
            
            # Get the method content - this depends on the smalanalysis library structure
            # We'll need to access the actual smali code from the method object
            if hasattr(method_obj, 'getLines'):
                for line in method_obj.getLines(): 
                    f.write(line+'\n')
            elif hasattr(method_obj, 'toString'):
                f.write(str(method_obj))
            else:
                f.write(f"# Method content not available\n")
                f.write(f"# Signature: {method_obj.getFullSignature()}\n")
        
        if args.verbose:
            print(f"Wrote {version_name} version to: {output_file}")
            
    except Exception as e:
        print(f"Error writing to {output_file}: {e}", file=sys.stderr)

try:
    old = SmaliProject.SmaliProject()
    old.parseProject(args.smaliv1, None, args.exclude_lists, args.include_lists, args.include_unpackaged, use_pysmali=not args.no_pysmali)

    new = SmaliProject.SmaliProject()
    new.parseProject(args.smaliv2, None, args.exclude_lists, args.include_lists, 
                    include_unpackaged=args.include_unpackaged, use_pysmali=not args.no_pysmali)

    diff = old.differences(new, [])
    for x in diff:
        if x is None or x[0] is None or x[0][0] is None: 
            continue 
        
        # Check if this class should be included based on filter
        class_name = x[0][0].name.replace('/', '.')
        if args.verbose: 
            print(class_name)
        if not should_filter_class(class_name):
            continue
        
        (sames, diffs) = x[0][0].methodsComparison(x[0][1], [])
        for fn in diffs: 
            old_method = fn[0]
            new_method = fn[1]
            
            # Write both old and new versions
            if old_method is not None:
                write_function_to_file(old_method, old_dir, "old")
            if new_method is not None:
                write_function_to_file(new_method, new_dir, "new")
            
            # Print the signature for reference
            differ = old_method if old_method is not None else new_method
            if verbose and differ is not None:
                print(differ.getFullSignature())
                
except Metrics.ProjectObfuscatedException:             
    print("This project is obfuscated. Unable to proceed.", file=sys.stderr)
    sys.exit(1)
