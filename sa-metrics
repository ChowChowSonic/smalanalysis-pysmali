#!/usr/bin/env python

import argparse
import sys
import os
import logging
from smalanalysis.smali import SmaliProject, Metrics

logging.basicConfig(level=logging.INFO, format='[%(levelname)s] %(message)s', stream=sys.stderr)

parser = argparse.ArgumentParser(description='Compute evolution metrics between two APK versions.')
parser.add_argument('apk1', type=str, help='Version 1 (APK file)')
parser.add_argument('apk2', type=str, help='Version 2 (APK file)')
parser.add_argument('pkg', type=str, nargs='?', default=None, help='Package name')
parser.add_argument('--verbose', '-v', action='store_true')
parser.add_argument('--onlyapppackage', '-P', dest='pkg_source', action='store_const', const='manual')
parser.add_argument('--include-unpackaged', '-U', action='store_true')
parser.add_argument('--exclude-lists', '-e', type=str, nargs='*')
parser.add_argument('--include-lists', '-i', type=str, nargs='*')
parser.add_argument('--with-innerclasses-split', '-I', action='store_true')
parser.add_argument('--skip-obfuscated', '-s', action='store_true')
parser.add_argument('--dump-obfuscation-csv', '-d', type=str, metavar='PATH',
                    help='Write per-class obfuscation heuristic details to CSV '
                         '(appends .old.csv / .new.csv per APK)')
args = parser.parse_args()

pkg = None
if args.pkg_source == 'manual':
    if args.pkg is None:
        parser.error("--onlyapppackage requires a package name argument.")
    pkg = args.pkg

try:
    old, _ = SmaliProject.SmaliProject.from_apk(
        args.apk1, pkg, skiplists=args.exclude_lists, includelist=args.include_lists,
        include_unpackaged=args.include_unpackaged,
    )

    new, _ = SmaliProject.SmaliProject.from_apk(
        args.apk2, pkg, skiplists=args.exclude_lists, includelist=args.include_lists,
        include_unpackaged=args.include_unpackaged,
    )

    if args.dump_obfuscation_csv:
        base = args.dump_obfuscation_csv
        old_csv = base + '.old.csv'
        new_csv = base + '.new.csv'
        SmaliProject.SmaliProject.writeObfuscationCSV(old, old_csv)
        SmaliProject.SmaliProject.writeObfuscationCSV(new, new_csv)
        print(f"Obfuscation details written to {old_csv} and {new_csv}", file=sys.stderr)

    if args.skip_obfuscated:
        old.removeObfuscatedClasses()
        new.removeObfuscatedClasses()

    mold, moldin = Metrics.countMethodsInProject(old)
    mnew, mnewin = Metrics.countMethodsInProject(new)
    diff = old.differences(new, [])
    metrics = {}

    if args.with_innerclasses_split:
        innerDiff, outerDiff = Metrics.splitInnerOuterChanged(diff)
        Metrics.initMetricsDict("OUT", metrics)
        Metrics.initMetricsDict("IN", metrics)
        metrics["IN#M-"] = moldin
        metrics["IN#M+"] = mnewin
        metrics["OUT#M-"] = mold
        metrics["OUT#M+"] = mnew
        Metrics.computeMetrics(outerDiff, metrics, "OUT", True, False)
        Metrics.computeMetrics(innerDiff, metrics, "IN", True, False)
    else:
        Metrics.initMetricsDict("", metrics)
        metrics["#M-"] = mold + moldin
        metrics["#M+"] = mnew + mnewin
        Metrics.computeMetrics(diff, metrics, "", True, False)
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)

core_metrics = [
    "#C-", "#C+", "#M-", "#M+",
    "MA", "MD", "MR", "MC", "MRev", "FA", "FD", "FC", "FR",
    "CA", "CD", "CC"
]
header_mapping = {
    "#C-": "old Classes", "#C+": "new Classes",
    "#M-": "old Methods", "#M+": "new Methods",
    "MA": "Mth_Added", "MD": "Mth_Deleted",
    "MR": "Mth_Renamed", "MC": "Mth_Changed",
    "MRev": "Mth_Revised", "FA": "Fld_Added",
    "FD": "Fld_Deleted", "FC": "Fld_Changed",
    "FR": "Fld_Renamed", "CA": "Cls_Added",
    "CD": "Cls_Deleted", "CC": "Cls_Changed"
}
bases = [""] if not args.with_innerclasses_split else ["IN", "OUT"]
print("Scope", end=',')
for m in core_metrics:
    print(header_mapping.get(m, m), end=',')
print("Added_Lines,Removed_Lines")
for b in bases:
    display_base = b if b else (pkg or "all")
    print(display_base, end=',')
    for m in core_metrics:
        key = "{}{}".format(b, m) if args.with_innerclasses_split else m
        print("{}".format(metrics.get(key, 0)), end=',')
    add_lines = "|".join(metrics.get("{}addedLines".format(b), []))
    rem_lines = "|".join(metrics.get("{}removedLines".format(b), []))
    print("{},{}".format(add_lines, rem_lines))
